{
  "name": "screeps-docs",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "packageManager": "npm@11.10.0",
  "hexo": {
    "version": "8.1.2"
  },
  "dependencies": {
    "@screeps/common": "2.16.1",
    "cheerio": "1.2.0",
    "hexo": "8.1.2",
    "hexo-generator-archive": "2.0.0",
    "hexo-generator-feed": "4.0.0",
    "hexo-generator-sitemap": "3.0.1",
    "hexo-renderer-marked": "7.0.1",
    "hexo-renderer-nunjucks": "2.0.0",
    "hexo-renderer-stylus": "3.0.1",
    "hexo-util": "4.0.0",
    "lunr": "0.6.0",
    "marked": "15.0.12",
    "prismjs": "1.30.0"
  },
  "devDependencies": {
    "hexo-server": "3.0.0"
  },
  "scripts": {
    "build": "npm run generate:root && npm --prefix api run generate && npm run verify",
    "clean": "hexo clean",
    "generate": "npm run build",
    "generate:root": "hexo clean && hexo generate",
    "generate-watch": "hexo generate --watch",
    "server": "hexo server",
    "verify": "node tools/verify-build.js"
  }
